{
  "services": {
    "LaunchPage": {
      "adapter": {
        "config": {
          "catalogs": [],
          "groups": [
            {
              "id": "Report",
              "title": "AI Report Utils",
              "isPreset": true,
              "isVisible": true,
              "isGroupLocked": false,
              "tiles": [
                {
                  "id": "Report",
                  "tileType": "sap.ushell.ui.tile.StaticTile",
                  "properties": {
                    "title": "AI Reports",
                    "targetURL": "#report-display"
                  }
                },
                {
                  "id": "Parameters",
                  "tileType": "sap.ushell.ui.tile.StaticTile",
                  "properties": {
                    "title": "Maintain Parameters",
                    "targetURL": "#parameter-display"
                  }
                },
                {
                  "id": "RAG",
                  "tileType": "sap.ushell.ui.tile.StaticTile",
                  "properties": {
                    "title": "Maintain Knowledges",
                    "targetURL": "#capragapp-display"
                  }
                }

              ]
            }
          ]
        }
      }
    },
    "NavTargetResolution": {
      "config": {
        "enableClientSideTargetResolution": true
      }
    },
    "ClientSideTargetResolution": {
      "adapter": {
        "config": {
          "inbounds": {
            "Report": {
              "semanticObject": "report",
              "action": "display",
              "title": "Report",
              "signature": {
                "parameters": {},
                "additionalParameters": "allowed"
              },
              "resolutionResult": {
                "applicationType": "SAPUI5",
                "additionalInformation": "SAPUI5.Component=report",
                "url": "/app/report/webapp"
              }
            },
            "ChatBotUI2": {
              "semanticObject": "chatbotui2",
              "action": "display",
              "title": "Chat with AI2",
              "signature": {
                "parameters": {},
                "additionalParameters": "allowed"
              },
              "resolutionResult": {
                "applicationType": "SAPUI5",
                "additionalInformation": "SAPUI5.Component=chatbotui2",
                "url": "/app/chatbotui2/webapp"
              }
            },
            "Parameter": {
              "semanticObject": "parameter",
              "action": "display",
              "title": "Parameter",
              "signature": {
                "parameters": {},
                "additionalParameters": "allowed"
              },
              "resolutionResult": {
                "applicationType": "SAPUI5",
                "additionalInformation": "SAPUI5.Component=parameters",
                "url": "/app/parameters/webapp"
              }
            },
            "RAG": {
              "semanticObject": "capragapp",
              "action": "display",
              "title": "Maintain Knowledges",
              "signature": {
                "parameters": {},
                "additionalParameters": "allowed"
              },
              "resolutionResult": {
                "applicationType": "SAPUI5",
                "additionalInformation": "SAPUI5.Component=capragapp",
                "url": "/app/cap-rag-app/webapp"
              }
            }
          }
        }
      }
    }
  }
}
