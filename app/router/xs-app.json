{
  "routes": [
    {
      "source": "^/app/(.*)$",
      "target": "$1",
      "localDir": ".",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^/appconfig/",
      "localDir": ".",
      "cacheControl": "no-cache, no-store, must-revalidate"
    },
    {
      "source": "^/report/webapp/api/(.*)$",
      "target": "api/$1",
      "destination": "ai2report-java-srv-api",
      "csrfProtection": false,
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "ai2report-java-srv-api",
      "csrfProtection": false,
      "authenticationType": "xsuaa"
    }
  ],
  "compression": {
    "enabled": false
  }
}