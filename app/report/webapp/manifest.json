{
  "_version": "1.65.0",
  "sap.app": {
    "id": "report",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.15.2",
      "toolsId": "4a768b66-d8a4-4216-9bd1-b80676d8f744"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/ai2report/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "report-display": {
          "semanticObject": "report",
          "action": "display",
          "title": "{{flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.130.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "report.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "updateGroupId": "update"
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ReportsList",
          "target": "ReportsList"
        },
        {
          "pattern": "Reports({key}):?query:",
          "name": "ReportsObjectPage",
          "target": "ReportsObjectPage"
        },
        {
          "pattern": "Reports({key})/fields({key2}):?query:",
          "name": "ReportFieldsObjectPage",
          "target": "ReportFieldsObjectPage"
        }
      ],
      "targets": {
        "ReportsList": {
          "type": "Component",
          "id": "ReportsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Reports",
              "variantManagement": "Page",
              "navigation": {
                "Reports": {
                  "detail": {
                    "route": "ReportsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "ReportsObjectPage": {
          "type": "Component",
          "id": "ReportsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Reports",
              "navigation": {
                "fields": {
                  "detail": {
                    "route": "ReportFieldsObjectPage"
                  }
                }
              },
              "content": {
                "header": {
                  "actions": {
                    "AIConversation": {
                      "press": "report.ext.AIConversation.AIConversation.onPressAIConversation",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{@i18n>chatWithAi}"
                    }
                  }
                }
              }
            }
          }
        },
        "ReportFieldsObjectPage": {
          "type": "Component",
          "id": "ReportFieldsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Reports/fields"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.cloud": {
    "public": true,
    "service": "aireport.service"
  }
}
