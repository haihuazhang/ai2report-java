<core:FragmentDefinition
    xmlns:html="http://www.w3.org/1999/xhtml"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:webc="sap.ui.webc.main"
    xmlns:f="sap.f"
    xmlns:custom="report.control"
    core:require="{
        LayoutManager: 'report/util/LayoutManager',
		ChatFormatter: 'report/formatter/ChatFormatter'
	}"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
    height="100%"
>
    <Dialog id="_IDGenDialog1WithStream" title="{i18n>AIConversationTitle}" contentHeight="100%"
        contentWidth="100%"
        verticalScrolling="true"
        resizable="true"
        class="dialogToRight markdownDialog"
    >
        <Page id="chatPageWithStream" class="sapUiContentPadding chatPage" showFooter="true"
            floatingFooter="false" showHeader="false">
            <content>
                <VBox id="_IDGenVBoxWithStream" class="sapUiMediumMarginBottom">
                    <List
                        id="messageListWithStream"
                        showNoData="false"
                        showSeparators="Inner"
                        items="{ 
                            path: 'records', 
                            sorter: { path: 'chatTime', descending: false },
                            filters: {
                                path: 'role',
                                operator: 'NE',
                                value1: 'system'
                            },
                            parameters: {
                                $$updateGroupId: 'changes'
                            }
                        }"
                    >
                        <custom:ChatMessageListItem id="_IDGenChatMessageListItemWithStream"
                            message="{content}"
                            sender="{role}"
                            date="{chatTime}"
                            class="customMessageListItem sapUiSmallMargin">
                            <custom:customData>
                                <core:CustomData 
                                    key="sender" 
                                    value="{role}"
                                    writeToDom="true"/>
                            </custom:customData>
                            <custom:avatar>
                                <Avatar id="_IDGenAvatarWithStream"
                                    displaySize="S"
                                    src="{ path: 'role', formatter: 'ChatFormatter.senderIcon' }"
                                    displayShape="Square"
                                    backgroundColor="Transparent"
                                />
                            </custom:avatar>

                            <custom:adopt>
    <Button id="_IDGenButton3WithStream"
        class="sapUiTinyMarginBegin"
        type="Emphasized"
        icon="sap-icon://thumb-up"
        text="{i18n>Button03}"
        press="onBtnAdoptPress"
        busyIndicatorDelay="0"
        visible="{= %{role} === 'assistant' &amp;&amp; !${@$ui5.context.isTransient}}"
    />
</custom:adopt>
                            <custom:display>
                            </custom:display>
                        </custom:ChatMessageListItem>
                    </List>
                    <Text
                        id="listEndMarkerWithStream"
                        text=""
                        visible="true"
                    />
                </VBox>


            </content>
            <footer>
                <OverflowToolbar id="_IDGenOverflowToolbarWithStream">
                    <FeedInput
                        id="newMessageInputWithStream"
                        post="onPostMessageWithStream"
                        showIcon="false"
                        growing="true"
                    />
                </OverflowToolbar>
            </footer>
        </Page>
        <buttons>
            <Button id="_IDGenButton2WithStream" text="Sync changes to chat list"
                press="onPressSyncChangesToChatList"></Button>
            <Button id="_IDGenButton4WithStream" text="Close"
                press="onAIConversationClose"></Button>
        </buttons>
        <endButton>

        </endButton>
    </Dialog>
</core:FragmentDefinition>