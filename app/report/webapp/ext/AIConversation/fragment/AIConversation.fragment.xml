            <!-- </headerContent> -->

            <content>
                <VBox id="_IDGenVBox" class="sapUiMediumMarginBottom">
                    <List
                        id="messageList"
                        showNoData="false"
                        showSeparators="Inner"
                        items="{ 
                            path: 'records', 
                            sorter: { path: 'chatTime', descending: false },
                            filters: {
                                path: 'role',
                                operator: 'NE',
                                value1: 'system'
                            },
                            parameters: {
                                $$updateGroupId: 'changes'
                            }
                        }"
                    >
                        <custom:ChatMessageListItem id="_IDGenChatMessageListItem"
                            message="{content}"
                            sender="{role}"
                            date="{chatTime}"
                        >
                            <custom:avatar>
                                <Avatar id="_IDGenAvatar"
                                    displaySize="S"
                                    src="{ path: 'role', formatter: 'ChatFormatter.senderIcon' }"
                                    displayShape="Square"
                                    backgroundColor="Transparent"
                                />
                            </custom:avatar>

                            <custom:adopt>
                                <Button id="_IDGenButton3"
                                    class="sapUiTinyMarginBegin"
                                    type="Emphasized"
                                    icon="sap-icon://thumb-up"
                                    text="{i18n>Button03}"
                                    press="onBtnAdoptPress"
                                    busyIndicatorDelay="0"
                                    visible="{= %{role} === 'assistant' }"
                                />
                                <!-- ${isAdopted} === false &amp;&amp; -->
                            </custom:adopt>
                            <custom:display>
                                <!-- <Button id="_IDGenButton4"
                                    class="sapUiTinyMarginBegin"
                                    type="Emphasized"
                                    icon="sap-icon://display"
                                    text="{i18n>Button04}"
                                    press="onBtnDisplayPress"
                                    busyIndicatorDelay="0"
                                    visible="{= ${isAdopted} === true &amp;&amp; %{role} === 'assistant' }"
                                /> -->
                            </custom:display>
                        </custom:ChatMessageListItem>
                    </List>
                    <Text
                        id="listEndMarker"
                        text=""
                        visible="true"
                    />
                </VBox>


            </content>
            <footer>
                <OverflowToolbar id="_IDGenOverflowToolbar">
                    <FeedInput
                        id="newMessageInput"
                        post="onPostMessage"
                        showIcon="false"
                        growing="true"
                    />
                </OverflowToolbar>
            </footer>
        </Page>
        <buttons>
            <Button id="_IDGenButton2" text="Sync changes to chat list"
                press="onPressSyncChangesToChatList"></Button>
            <Button id="_IDGenButton4" text="Close"
                press="onAIConversationClose"></Button>
        </buttons>
        <endButton>

        </endButton>
    </Dialog>
