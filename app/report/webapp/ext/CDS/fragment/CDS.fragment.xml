        <f:Form id="_IDGenForm" editable="true">
            <f:layout>
                <f:ColumnLayout id="_IDGenColumnLayout"
                    columnsXL="1"
                    columnsL="1"
                    labelCellsLarge="12"
                />
            </f:layout>
            <f:formContainers>
                <f:FormContainer id="_IDGenFormContainer">
                    <f:formElements>
                        <f:FormElement id="_IDGenFormElement1" label="{i18n>CDS1}">
                            <f:fields>
                                <TextArea id="_IDGenTextArea" rows="20"
                                    value="{CDS1}"
                                    editable="false">

                                </TextArea>

                            </f:fields>
                        </f:FormElement>
                        <f:FormElement id="_IDGenFormElement2" label="{i18n>CDS2}">
